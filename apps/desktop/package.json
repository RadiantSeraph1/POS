{
  "name": "@pipeflow/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node scripts/build-desktop.mjs",
    "build:cli": "tsc -p tsconfig.json",
    "dev": "node scripts/dev-desktop.mjs",
    "dev:cli": "node --watch src/main.ts",
    "lint": "node -e \"console.log('No lint configured yet for @pipeflow/desktop')\"",
    "test": "node --test --test-isolation=none \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electron": "^42.1.0",
    "esbuild": "^0.28.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
